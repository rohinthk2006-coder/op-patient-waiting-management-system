# Application Configuration
PROJECT_NAME="Hospital OP Live Tracker"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Security & Authentication
SECRET_KEY="super-secret-hospital-op-key-change-in-production-minimum-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB Configuration
# Local MongoDB or MongoDB Atlas URI (e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/op_live_tracker)
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="hospital_op_tracker"

# CORS Origins
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Queue Configuration
DEFAULT_GRACE_PERIOD_MINUTES=10
EXPIRY_WORKER_INTERVAL_SECONDS=30
RESTART_RECOVERY_ON_BOOT=True

# External Notification Providers (Optional)
SMS_PROVIDER="development_mock"
EMAIL_PROVIDER="development_mock"
